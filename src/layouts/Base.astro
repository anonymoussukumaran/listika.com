---
import '../styles/global.css';
import { serializeJsonLd } from '../utils/json-ld.mjs';
interface Props { title: string; description: string; structuredData?: Record<string, unknown>[]; }
const { title, description, structuredData = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === 'Listika' ? title : `${title} | Listika`;
const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': new URL('/#website', Astro.site).href, name: 'Listika', url: new URL('/', Astro.site).href };
const schemas = canonical.pathname === '/' ? [website, ...structuredData] : structuredData;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Listika" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {schemas.map((schema) => <script type="application/ld+json" set:html={serializeJsonLd(schema)} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <meta name="theme-color" content="#f7f6f0" />
    <meta name="google-adsense-account" content="ca-pub-6649279084873350" />
    <script is:inline src="/consent.js" defer></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="Listika home">listika<span>.</span></a>
        <span class="brand-note">The useful<br />list index</span>
        <nav aria-label="Main navigation"><a href="/#lists">Explore lists</a><a href="/about/">About</a></nav>
      </div>
    </header>
    <dialog id="privacy-choice" class="privacy-choice" aria-labelledby="privacy-choice-title" aria-describedby="privacy-choice-description">
      <div class="privacy-choice-inner">
        <div><p class="eyebrow">YOUR PRIVACY</p><h2 id="privacy-choice-title" tabindex="-1">Help us understand visits?</h2>
          <p id="privacy-choice-description">With your permission, Google Analytics uses cookies to measure how people use Listika. You can choose without affecting access to the site and change your choice any time. <a href="/privacy/">Read our privacy policy</a>.</p>
          <p id="privacy-choice-message" role="status" aria-live="polite" hidden></p>
        </div>
        <div class="privacy-choice-actions"><button type="button" id="privacy-accept">Allow analytics</button><button type="button" id="privacy-reject">Reject analytics</button></div>
      </div>
    </dialog>
    <p id="privacy-storage-warning" class="privacy-storage-warning" role="status" hidden>Your choice could not be saved. Analytics is off on this page; you may be asked again on another page.</p>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="wrap footer-inner"><div><a class="footer-brand" href="/">listika.</a><p>Curated lists. Sources included.</p></div><nav aria-label="Footer navigation"><a href="/about/">About</a><a href="/editorial/">How we work</a><a href="/privacy/">Privacy</a><button type="button" id="privacy-settings" hidden>Privacy settings</button></nav></div></footer>
  </body>
</html>
