---
import Base from '../../layouts/Base.astro';
import { lists } from '../../data';
const kochiLists = lists.filter((list) => list.collections?.includes('kochi'));
export function getStaticPaths() {
  const matchingLists = lists.filter((list) => list.collections?.includes('kochi'));
  return matchingLists.length >= 2 ? [{ params: { slug: 'kochi' } }] : [];
}
---
<Base title="Lists about Kochi" description="Explore Listika's source-linked lists about Kochi, from running events to places to visit.">
  <div class="wrap">
    <div class="index-line"><span><a href="/">THE INDEX</a> / COLLECTION</span><span>KOCHI</span></div>
    <header class="list-heading">
      <div><p class="eyebrow">A collection of lists</p><h1>Lists about Kochi.</h1><p class="lede">A place to find our Kochi-related lists together, from running events to places to explore.</p></div>
      <div class="intro-marker"><span class="marker-label">IN THIS COLLECTION</span><strong>{String(kochiLists.length).padStart(2, '0')}</strong><span>{kochiLists.length === 1 ? 'list' : 'lists'} to explore</span></div>
    </header>
    <section class="index-section" aria-labelledby="collection-lists">
      <div class="section-header"><div><p class="eyebrow">KOCHI / COLLECTION</p><h2 id="collection-lists">All Kochi lists</h2></div><p>Each list links to sources for its entries.</p></div>
      {kochiLists.length ? <ul class="list-index">{kochiLists.map((list) => <li><a class="list-index-item" href={`/lists/${list.slug}/`}><span class="item-index" aria-hidden="true">↳</span><span class="item-text"><strong>{list.title}</strong><span>{list.description}</span></span><span class="item-arrow" aria-hidden="true">↗</span></a></li>)}</ul> : <p>There are no published lists in this collection right now.</p>}
    </section>
    <section class="method-callout"><div><p class="eyebrow">KEEP EXPLORING</p><h2>More from Listika.</h2></div><div><p>Explore all published lists, as the collection grows across topics and places.</p><a class="text-link" href="/#lists">Browse all lists <span aria-hidden="true">↗</span></a></div></section>
  </div>
</Base>
